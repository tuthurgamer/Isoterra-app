<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tournée — Isoterra</title>
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#2a2018">
<meta name="mobile-web-app-capable" content="yes">
<link rel="icon" href="/icons/favicon-logo-64.png" type="image/png">
<link rel="apple-touch-icon" href="/icons/logo-192.png">
<link rel="stylesheet" href="/css/style.css?v=20261031">
</head>
<body>
<div class="tour-screen tour-screen--center">
  <div class="tour-done">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="var(--moss)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="tour-done__check"><path d="M5 13l4 4L19 7"/></svg>
    <div class="wordmark tour-done__title">
      <% if (empty) { %>Rien à faire<% } else { %>Tournée terminée<% } %>
    </div>
    <div class="tour-done__text">
      <% if (empty) { %>
        Aucun bac pour l'instant. Ajoute ta première fiche pour commencer.
      <% } else { %>
        <span data-tour-total><%= total %> bac<%= total > 1 ? 's' : '' %> vérifié<%= total > 1 ? 's' : '' %></span>. À demain.
      <% } %>
    </div>
    <a href="/" class="btn">Retour au registre</a>
  </div>
</div>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
<script src="/js/hors-ligne.js?v=1"></script>
<script>
  // The copy of this page kept for no network counts the bacs of this tournée.
  (function () {
    var el = document.querySelector('[data-tour-total]');
    var n = (new URLSearchParams(location.search).get('bacs') || '').split(',').filter(Boolean).length;
    if (el && n) el.textContent = n + ' bac' + (n > 1 ? 's' : '') + ' vérifié' + (n > 1 ? 's' : '');
  })();
</script>
</body>
</html>
