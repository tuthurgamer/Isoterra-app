<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tournée — Isoterra</title>
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#2a2018">
<meta name="mobile-web-app-capable" content="yes">
<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icons/icon-192.png">
<link rel="stylesheet" href="/css/style.css?v=20261008">
</head>
<body>
<div class="tour-screen tour-screen--center">
  <div class="tour-done">
    <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="var(--moss)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="tour-done__check"><path d="M5 13l4 4L19 7"/></svg>
    <div class="wordmark tour-done__title">
      <% if (empty) { %>Rien à faire<% } else { %>Tournée terminée<% } %>
    </div>
    <div class="tour-done__text">
      <% if (empty) { %>
        Aucun bac pour l'instant. Ajoute ta première fiche pour commencer.
      <% } else { %>
        <%= total %> bac<%= total > 1 ? 's' : '' %> vérifié<%= total > 1 ? 's' : '' %>. À demain.
      <% } %>
    </div>
    <a href="/" class="btn">Retour au registre</a>
  </div>
</div>
</body>
</html>
