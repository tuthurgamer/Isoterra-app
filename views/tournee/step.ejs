<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tournée — Isoterra</title>
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#2a2018">
<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/style.css">
<style>
  .action-btn{display:flex; flex-direction:column; align-items:center; gap:8px; padding:18px 10px; border:1.5px solid var(--line-strong); background:var(--paper); flex:1; cursor:pointer; color:inherit;}
  .action-btn:hover{background:var(--paper-alt);}
  .action-btn .lbl{font-size:12px; font-style:italic; color:var(--ink-muted);}
</style>
</head>
<body>
<div style="min-height:100vh; background:var(--desk); display:flex; flex-direction:column; align-items:center; padding:36px 24px;">

  <div style="width:100%; max-width:560px; display:flex; align-items:center; justify-content:space-between; margin-bottom:22px;">
    <a href="/" style="color:var(--paper-alt); font-family:'Special Elite',monospace; font-size:13px; opacity:0.8; text-decoration:none;">&times;&nbsp;&nbsp;Quitter la tournée</a>
    <div style="color:var(--paper-alt); font-family:'Special Elite',monospace; font-size:13px; opacity:0.8;">BAC <%= position %> / <%= total %></div>
  </div>
  <div style="width:100%; max-width:560px; height:4px; background:rgba(255,255,255,0.12); margin-bottom:34px;">
    <div style="width:<%= Math.round((position - 1) / total * 100) %>%; height:100%; background:var(--rust);"></div>
  </div>

  <div style="position:relative; width:100%; max-width:560px;">
    <% if (total - position >= 2) { %><div style="position:absolute; inset:0; background:var(--paper-alt); border:1px solid var(--line); transform:rotate(3deg) translateY(10px); box-shadow:0 10px 20px rgba(0,0,0,0.3);"></div><% } %>
    <% if (total - position >= 1) { %><div style="position:absolute; inset:0; background:var(--paper-alt); border:1px solid var(--line); transform:rotate(-2deg) translateY(5px); box-shadow:0 10px 20px rgba(0,0,0,0.3);"></div><% } %>

    <div style="position:relative; background:var(--paper); border:1.5px solid var(--ink); padding:32px; box-shadow:0 18px 40px rgba(0,0,0,0.45);">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:18px;">
        <a href="/fiches/<%= fiche.id %>" style="color:var(--rust);"><%- icons.species(fiche.category, 42) %></a>
        <div style="font-family:'Special Elite',monospace; font-size:10px; color:var(--ink-faint);"><%= fmt.numTag(fiche.bac_id) %></div>
      </div>
      <div class="wordmark" style="font-size:22px;"><%= fiche.morph ? fiche.common_name + ' ' + fiche.morph : fiche.common_name %></div>
      <div style="font-style:italic; color:var(--ink-muted); font-size:13.5px; margin-bottom:6px;"><%= fiche.scientific_name %><%= fiche.morph ? " '" + fiche.morph + "'" : '' %></div>
      <div style="font-family:'Special Elite',monospace; font-size:10.5px; color:var(--ink-faint); margin-bottom:22px;">dernière vérification : <%= fmt.relative(fiche.last_checked_at) %></div>

      <div style="display:flex; gap:10px; margin-bottom:14px;">
        <% [['nourrissage','Nourri'], ['nettoyage','Nettoyé'], ['mue','Mue'], ['observation','RAS']].forEach(function(a) { %>
          <form method="POST" action="/tournee/step/log?queue=<%= queue %>&i=<%= i %>&type=<%= a[0] %>" style="flex:1;">
            <button type="submit" class="action-btn" style="width:100%;">
              <%- icons.action(a[0]) %>
              <div class="lbl"><%= a[1] %></div>
            </button>
          </form>
        <% }); %>
      </div>
      <div style="text-align:center; font-style:italic; color:var(--ink-muted); font-size:12.5px; padding-top:10px; border-top:1px dashed var(--line);">
        <a href="/journal/new?fiche_id=<%= fiche.id %>" style="color:inherit;">+ ajouter une note ou une photo</a>
      </div>
    </div>
  </div>

  <div style="margin-top:28px; color:var(--paper-alt); opacity:0.65; font-size:12.5px; font-style:italic; text-align:center;">
    Tape une action pour passer au bac suivant &mdash; <a href="<%= nextUrl %>" style="color:var(--paper-alt); text-decoration:underline;">passer ce bac</a>
  </div>
</div>
</body>
</html>
