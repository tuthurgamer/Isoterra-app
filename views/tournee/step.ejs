<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tournée — Isoterra</title>
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#2a2018">
<meta name="mobile-web-app-capable" content="yes">
<link rel="icon" href="/icons/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icons/icon-192.png">
<link rel="stylesheet" href="/css/style.css?v=20261012">
</head>
<body>
<div class="tour-screen">

  <div class="tour-top">
    <a href="/">&times;&nbsp;&nbsp;Quitter la tournée</a>
    <span>BAC <%= position %> / <%= total %></span>
  </div>
  <div class="tour-progress"><div style="width:<%= Math.round((position - 1) / total * 100) %>%;"></div></div>

  <div class="tour-stack">
    <% if (total - position >= 2) { %><div class="tour-stack__back" style="transform:rotate(3deg) translateY(10px);"></div><% } %>
    <% if (total - position >= 1) { %><div class="tour-stack__back" style="transform:rotate(-2deg) translateY(5px);"></div><% } %>

    <% var mixed = fiches.length > 1; var first = fiches[0]; %>
    <div class="tour-card">
      <% if (mixed) { %>
        <div class="tour-card__top">
          <div class="wordmark tour-card__title">Bac mixte</div>
          <div class="tour-card__num"><%= fmt.numTag(bac.id) %><% if (bac.name) { %><br><%= bac.name %><% } %></div>
        </div>
        <ul class="tour-mix">
          <% fiches.forEach(function (f) { %>
            <li>
              <a href="/bacs/<%= bac.id %>#fiche-<%= f.id %>">
                <span class="tour-mix__icon"><%- icons.species(f, 96) %></span>
                <span class="tour-mix__name"><%= f.scientific_name %><%= f.morph ? " '" + f.morph + "'" : '' %></span>
              </a>
            </li>
          <% }); %>
        </ul>
      <% } else { %>
        <div class="tour-card__top">
          <a href="/bacs/<%= bac.id %>" class="tour-card__icon"><%- icons.species(first, 190) %></a>
          <div class="tour-card__num"><%= fmt.numTag(bac.id) %><% if (bac.name) { %><br><%= bac.name %><% } %></div>
        </div>
        <div class="wordmark tour-card__name"><%= first.scientific_name %><%= first.morph ? " '" + first.morph + "'" : '' %></div>
      <% } %>
      <div class="tour-card__last">dernière vérification : <%= fmt.relative(bac.lastChecked) %></div>
      <% if (bac.care) { %>
        <div class="care-row tour-card__care">
          <% [['feed', 'nourrissage'], ['mist', 'pulverisation']].forEach(function (c) { var item = bac.care[c[0]]; %>
            <div class="care-item<%= item.level ? ' care-item--' + item.level : '' %>">
              <%- icons.action(c[1]) %>
              <span><%= item.text %></span>
            </div>
          <% }); %>
        </div>
      <% } %>

      <form method="POST" action="/tournee/step/log?bacs=<%= queue %>&amp;i=<%= i %>" class="tour-form">
        <div class="tour-actions">
          <% [['nourrissage','Nourri'], ['nettoyage','Nettoyé'], ['pulverisation','Pulvérisé'], ['observation','RAS']].forEach(function(a) { %>
            <label class="action-toggle">
              <input type="checkbox" name="types" value="<%= a[0] %>">
              <span class="action-btn">
                <%- icons.action(a[0]) %>
                <span class="lbl"><%= a[1] %></span>
              </span>
            </label>
          <% }); %>
        </div>
        <button type="submit" class="tour-submit"><span class="tour-submit__label">Valider et suivant</span></button>
        <% if (mixed) { %>
          <p class="tour-card__shared">Les actions cochées sont notées pour les <%= fiches.length %> espèces du bac.</p>
        <% } %>
      </form>

      <div class="tour-card__note">
        <a href="/bacs/<%= bac.id %>#note">+ ajouter une note ou une photo</a>
      </div>
    </div>
  </div>

  <div class="tour-foot">
    <span>Coche une ou plusieurs actions, puis valide</span>
    <a href="<%= nextUrl %>" class="tour-skip">Passer ce bac</a>
  </div>
</div>

<script>
  (function () {
    var form = document.querySelector('.tour-form');
    var submit = form.querySelector('.tour-submit');
    var label = submit.querySelector('.tour-submit__label');

    function refresh() {
      var n = form.querySelectorAll('input[type="checkbox"]:checked').length;
      submit.disabled = n === 0;
      label.textContent = n === 0 ? 'Coche au moins une action'
        : n === 1 ? 'Valider et suivant'
        : 'Valider ' + n + ' actions';
    }

    form.addEventListener('change', refresh);
    form.addEventListener('submit', function () {
      // Avoid a double tap logging everything twice.
      window.setTimeout(function () { submit.disabled = true; }, 0);
    });
    window.addEventListener('pageshow', refresh);
    refresh();
  })();
</script>
</body>
</html>
