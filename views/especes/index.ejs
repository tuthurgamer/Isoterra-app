<%- include('../partials/header', { title, active }) %>

<div class="masthead">
  <div>
    <div class="eyebrow">ESPÈCES</div>
    <h1>Guide des espèces</h1>
    <div class="subtitle"><%= total %> fiches — organisées comme tu les penses</div>
  </div>
  <div style="display:flex; gap:8px;">
    <a href="/especes/compatibilite" class="stamp stamp--rust">Comparateur &amp; groupes</a>
    <a href="/especes/new" class="stamp stamp--muted">+ nouvelle espèce</a>
  </div>
</div>
<div class="rule-double"></div>
<div class="rule-thin"></div>

<% byCategory.forEach(function(group) { %>
  <div class="section-title" style="margin-top:34px;">
    <%- icons.species(group.key, 24) %>
    <h2><%= group.label %></h2>
    <div class="rule"></div>
    <div class="count"><%= group.items.length %></div>
  </div>

  <% group.items.forEach(function(sp) { %>
    <a href="/especes/<%= sp.id %>" class="species-row">
      <span class="species-row__icon"><%- icons.species(sp, 56) %></span>
      <span class="species-row__name"><%= sp.scientific_name %></span>
      <span class="species-row__diff"><%- icons.ratingDiamonds(sp.difficulty) %></span>
      <span class="species-row__hum">
        <% if (sp.humidity_min) { %><%= sp.humidity_min %>–<%= sp.humidity_max %>%<% } else { %>—<% } %>
      </span>
    </a>
  <% }); %>
<% }); %>

<%- include('../partials/footer') %>
