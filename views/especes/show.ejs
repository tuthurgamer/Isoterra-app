<%- include('../partials/header', { title, active }) %>

<div class="masthead">
  <div>
    <div class="eyebrow">ESPÈCES &gt; <%= sp.scientific_name.toUpperCase() %></div>
    <h1>Guide d'élevage</h1>
  </div>
  <div style="display:flex; gap:8px; align-items:center;">
    <% if (sp.is_draft) { %><div class="stamp stamp--red">Brouillon — à affiner</div><% } %>
    <a href="/especes/<%= sp.id %>/fiche-client" class="stamp stamp--rust">Fiche client</a>
    <a href="/especes/<%= sp.id %>/edit" class="stamp stamp--muted">Modifier</a>
  </div>
</div>
<div class="rule-double"></div>
<div class="rule-thin"></div>

<div class="grid-2col">
  <div>
    <div class="wordmark" style="font-size:24px; font-style:italic; margin-bottom:18px;"><%= sp.scientific_name %></div>

    <div class="plate-frame">
      <div class="inner"><%- icons.species(sp, sp.icon_path ? 320 : 100) %></div>
      <div class="caption"><%= sp.scientific_name.toUpperCase() %></div>
    </div>

    <div class="ratings-box">
      <div class="rating-row">
        <div class="rating-label">Difficulté</div>
        <div class="rating-value"><%- icons.ratingDiamonds(sp.difficulty) %></div>
      </div>
      <div class="rating-row">
        <div class="rating-label">Humidité</div>
        <div class="rating-value">
          <%- icons.humidityDroplets(sp.humidity_min || 0, sp.humidity_max || 0) %>
          <% if (sp.humidity_min) { %><%= sp.humidity_min %>–<%= sp.humidity_max %>%<% } %>
        </div>
      </div>
      <div class="rating-row">
        <div class="rating-label">Température</div>
        <div class="rating-value" style="display:flex; align-items:center; gap:8px;">
          <%- icons.thermometer() %>
          <% if (sp.temp_min) { %><%= sp.temp_min %>–<%= sp.temp_max %>°C<% } else { %>—<% } %>
        </div>
      </div>
      <div class="rating-row">
        <div class="rating-label">Espérance de vie</div>
        <div class="rating-value"><%= sp.lifespan || '—' %></div>
      </div>
      <div class="rating-row">
        <div class="rating-label">Sociabilité</div>
        <div class="rating-value" style="display:flex; align-items:center; gap:8px;"><%- icons.group() %> <%= sp.sociability || '—' %></div>
      </div>
      <div class="rating-row">
        <div class="rating-label">Alimentation</div>
        <div class="rating-value" style="display:flex; align-items:center; gap:8px;"><%- icons.leaf() %> <%= sp.diet_summary || '—' %></div>
      </div>
      <div class="rating-row">
        <div class="rating-label">Vigilance</div>
        <div class="rating-value" style="display:flex; align-items:center; gap:8px;">
          <%- icons.warning(sp.vigilance && sp.vigilance !== 'Aucune' ? 'var(--stampred)' : 'var(--ink-faint)') %>
          <%= sp.vigilance || 'Aucune' %>
        </div>
      </div>
      <div class="rating-row">
        <div class="rating-label">Rythme de soins</div>
        <div class="rating-value">
          <div class="care-item"><%- icons.action('nourrissage') %><span>Nourrir <%= sp.feed_every_days ? 'tous les ' + sp.feed_every_days + ' j' : '— pas d\'alerte' %></span></div>
          <div class="care-item"><%- icons.action('pulverisation') %><span>Pulvériser <%= sp.mist_every_days ? 'tous les ' + sp.mist_every_days + ' j' : '— pas d\'alerte' %></span></div>
        </div>
      </div>
      <div class="rating-row">
        <div class="rating-label">Cohabitation</div>
        <div class="rating-value">
          <div class="trait-list">
            <% [['diet_type', 'Régime'], ['size_class', 'Taille'], ['niche', 'Occupe'], ['substrate_type', 'Installation']].forEach(function (t) {
                 var opt = traitOptions[t[0]].find(function (o) { return o[0] === sp[t[0]]; }); %>
              <span><em><%= t[1] %> :</em> <%= opt ? opt[1] : '—' %></span>
            <% }); %>
          </div>
          <a class="trait-link" href="/especes/compatibilite?a=<%= sp.id %>">Voir avec qui elle cohabite le mieux</a>
        </div>
      </div>
    </div>

    <div class="species-photos" id="photos">
      <div class="species-photos__head"><span>Photos de mon élevage</span><% if (photoCount) { %><a href="/photos?espece=<%= sp.id %>">Tout voir (<%= photoCount %>)</a><% } %></div>
      <% if (photos.length) { %>
        <div class="photo-strip" data-photo-group>
          <% photos.forEach(function (photo) { %><%- include('../photos/_thumb', { photo: photo }) %><% }); %>
        </div>
        <p class="species-photos__hint"><%= sp.showcase_photo ? 'Une de ces photos est sur la fiche client.' : "Ouvre une photo puis « Fiche client » pour la mettre sur la fiche client." %></p>
      <% } else { %>
        <p class="species-photos__hint">Aucune photo de cette espèce pour l'instant.</p>
      <% } %>

      <details class="species-photos__add" id="ajouter-photos">
        <summary>+ Ajouter des photos</summary>
        <form method="POST" action="/especes/<%= sp.id %>/photos" enctype="multipart/form-data" class="species-photos__form" data-envoi="espece:<%= sp.id %>">
          <a href="/appareil?espece=<%= sp.id %>" class="btn camera-link species-photos__camera"><%- icons.nav('photos') %><span>Prendre avec l'appareil photo</span></a>
          <% if (bacs.length) { %>
            <div class="field">
              <label>Ranger dans le journal de</label>
              <select name="fiche_id" data-picker>
                <% bacs.forEach(function (b) { %>
                  <option value="<%= b.id %>" data-pics="<%= icons.pic(sp) %>">Bac <%= fmt.numTag(b.bac_id) %><%= b.bac_name ? ' « ' + b.bac_name + ' »' : '' %></option>
                <% }); %>
                <option value="" data-pics="<%= icons.pic(sp) %>">Aucun bac : seulement avec l'espèce</option>
              </select>
            </div>
          <% } else { %>
            <input type="hidden" name="fiche_id" value="">
            <p class="species-photos__hint">Cette espèce n'est dans aucun bac : les photos restent avec elle, dans le guide et la galerie.</p>
          <% } %>
          <div class="field">
            <label>Note (optionnelle)</label>
            <textarea name="note" rows="2" placeholder="ex. Adulte en train de muer"></textarea>
          </div>
          <label class="hub-photo">
            <input type="file" name="photo" accept="image/*,video/*" multiple required data-photo-input>
            <span data-photo-label>+ Choisir photos et vidéos</span>
          </label>
          <div class="photo-preview" data-photo-preview hidden></div>
          <button type="submit" class="btn">Ajouter</button>
        </form>
      </details>
    </div>

    <% if (bacs.length) { %>
      <div style="margin-top:18px; font-size:12.5px; color:var(--ink-muted);">
        Élevé dans : <% bacs.forEach(function(b, i) { %><a href="/fiches/<%= b.id %>"><%= b.morph || fmt.numTag(b.bac_id) %></a><%= i < bacs.length - 1 ? ', ' : '' %><% }); %>
      </div>
    <% } %>
  </div>

  <div>
    <div class="wordmark" style="font-size:18px;">Présentation</div>
    <div style="border-top:1px solid var(--line-strong); margin:6px 0 12px;"></div>
    <div style="font-size:14px; line-height:1.7;"><%= sp.presentation || '—' %></div>

    <div class="wordmark" style="font-size:18px;">Habitat</div>
    <div style="border-top:1px solid var(--line-strong); margin:6px 0 12px;"></div>
    <div style="font-size:14px; line-height:1.7;"><%= sp.habitat || '—' %></div>

    <div class="wordmark" style="font-size:18px;">Alimentation</div>
    <div style="border-top:1px solid var(--line-strong); margin:6px 0 12px;"></div>
    <div style="font-size:14px; line-height:1.7;"><%= sp.feeding_detail || '—' %></div>

    <div class="repro-box">
      <h3>Reproduction</h3>
      <div class="rule"></div>

      <div class="repro-field"><h4>Sexage</h4><p><%= sp.repro_sexing || '—' %></p></div>
      <div class="repro-field"><h4>Conditions favorables</h4><p><%= sp.repro_conditions || '—' %></p></div>
      <div class="repro-field"><h4>Accouplement et ponte</h4><p><%= sp.repro_mating || '—' %></p></div>
      <div class="repro-field"><h4>Incubation</h4><p><%= sp.repro_incubation || '—' %></p></div>
      <div class="repro-field"><h4>Naissance et juvéniles</h4><p><%= sp.repro_juveniles || '—' %></p></div>

      <% if (sp.repro_pitfalls) { %>
      <div class="pitfalls">
        <div class="head"><%- icons.warning() %><h4>Pièges à éviter</h4></div>
        <p><%= sp.repro_pitfalls %></p>
      </div>
      <% } %>
    </div>

    <div class="draft-note">Cette fiche est un point de départ général — à corriger et compléter avec ta propre expérience d'éleveur.</div>
  </div>
</div>

<script>
  (function () {
    if (location.hash === '#ajouter-photos') document.getElementById('ajouter-photos').open = true;
    <% if (notice) { %>
    document.addEventListener('DOMContentLoaded', function () {
      var toast = document.getElementById('toast');
      toast.textContent = <%- JSON.stringify(notice).replace(/</g, '\\u003c') %>;
      toast.hidden = false;
      setTimeout(function () { toast.hidden = true; }, 2600);
      history.replaceState(null, '', location.pathname + location.hash);
    });
    <% } %>
  })();
</script>

<%- include('../partials/footer') %>
