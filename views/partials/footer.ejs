  </main>
</div>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
<script src="/js/photo-prep.js?v=3"></script>
<script src="/js/envois.js?v=2"></script>
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/service-worker.js')
        .then((registration) => registration.update())
        .catch(() => {});
      // Garde toutes les icônes d'espèces sur le téléphone (seules celles qui
      // manquent sont téléchargées), y compris quand une nouvelle version de
      // l'app vient de prendre la main.
      navigator.serviceWorker.ready.then((registration) => {
        if (registration.active) registration.active.postMessage('icones');
      });
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (navigator.serviceWorker.controller) navigator.serviceWorker.controller.postMessage('icones');
      });
    });
  }

  // Actions rapides des cartes : on enregistre sans recharger la page, pour ne
  // pas perdre sa place dans la liste. Sans JavaScript, le formulaire reste un
  // envoi classique (le serveur redirige comme avant).
  (function () {
    var toast = document.getElementById('toast');
    var toastTimer;
    function showToast(message) {
      toast.textContent = message;
      toast.hidden = false;
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () { toast.hidden = true; }, 1800);
    }

    var LEVELS = ['ras', 'verifier', 'retard', 'alerte'];

    // Applies the statuses the server recomputed after an entry: every card
    // of the same bac (feeding/misting count for the whole bac) and the
    // "en retard ou en alerte" total.
    function applyCare(data) {
      (data.statuses || []).forEach(function (s) {
        paint(document.querySelector('.specimen-card[data-fiche="' + s.fiche + '"]'), s);
      });
      // A mixed bac's card and a bac's page show the bac's own summary.
      if (data.bacStatus) {
        document.querySelectorAll('[data-bac="' + data.bacStatus.bac + '"]').forEach(function (el) { paint(el, data.bacStatus); });
      }
      var count = document.querySelector('[data-attention-count]');
      if (count && typeof data.attention === 'number') count.textContent = data.attention;
    }

    function paint(card, s) {
      if (!card) return;
      LEVELS.forEach(function (l) { card.classList.remove('level-' + l); });
      if (s.level) card.classList.add('level-' + s.level);
      var pill = card.querySelector('[data-level-pill]');
      if (pill) {
        pill.className = 'level-pill' + (s.level ? ' level-pill--' + s.level : '');
        pill.textContent = s.label || '';
        pill.hidden = !s.level;
      }
      [['feed', s.feed], ['mist', s.mist]].forEach(function (pair) {
        var item = card.querySelector('[data-care="' + pair[0] + '"]');
        if (!item || !pair[1]) return;
        item.className = 'care-item' + (pair[1].level ? ' care-item--' + pair[1].level : '');
        item.querySelector('.care-item__text').textContent = pair[1].text;
      });
    }

    document.addEventListener('submit', function (event) {
      var form = event.target;
      if (!form.matches || !form.matches('form[data-quicklog]')) return;
      event.preventDefault();

      var button = form.querySelector('button');
      if (button.disabled) return;
      button.disabled = true;

      fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'fetch' } })
        .then(function (response) {
          if (!response.ok) throw new Error('HTTP ' + response.status);
          return response;
        })
        .then(function (response) {
          // The entry is saved from here on: nothing below may fall back to
          // re-submitting the form, which would log it a second time.
          button.classList.add('done');
          var card = form.closest('.specimen-card');
          var last = card && card.querySelector('[data-last-obs]');
          if (last) last.textContent = "obs. aujourd'hui";
          showToast('Enregistré : ' + form.dataset.label);
          setTimeout(function () { button.classList.remove('done'); button.disabled = false; }, 900);
          if ((response.headers.get('content-type') || '').indexOf('application/json') !== -1) {
            response.json().then(applyCare).catch(function () {});
          }
        }, function () {
          // The entry could not be sent: fall back to a plain form submission.
          button.disabled = false;
          form.submit();
        });
    });
  })();

  // Envoi des photos. Une photo met plusieurs secondes à partir vers le Pi,
  // et l'app installée n'affiche aucune barre de chargement : sans retour, on
  // touche de nouveau « Enregistrer » ou on change de page, ce qui annule
  // l'envoi en cours et la photo est perdue. Les formulaires avec une photo
  // partent donc par ce script : un panneau montre l'avancement et couvre la
  // page jusqu'à la fin, et un échec est annoncé (la photo reste choisie, on
  // peut réessayer). Les photos sont réduites sur le téléphone avant de
  // partir, ce qui rend l'envoi bien plus court.
  (function () {
    var veil, card, title, bar, hint, closeBtn;

    function holdPage(event) {
      event.preventDefault();
      event.returnValue = '';
    }

    function show(text, percent, note) {
      if (!veil) {
        veil = document.createElement('div');
        veil.className = 'upload-veil';
        veil.innerHTML = '<div class="upload-card" role="alertdialog" aria-live="assertive">'
          + '<div class="upload-card__title"></div><div class="upload-bar"><span></span></div>'
          + '<p class="upload-card__hint"></p>'
          + '<button type="button" class="btn upload-card__close" hidden>Fermer</button></div>';
        document.body.appendChild(veil);
        card = veil.firstChild;
        title = card.querySelector('.upload-card__title');
        bar = card.querySelector('.upload-bar');
        hint = card.querySelector('.upload-card__hint');
        closeBtn = card.querySelector('.upload-card__close');
      }
      veil.hidden = false;
      card.classList.remove('is-error');
      closeBtn.hidden = true;
      title.textContent = text + (percent != null ? ' ' + percent + ' %' : '');
      bar.classList.toggle('is-busy', percent == null);
      bar.firstChild.style.width = percent == null ? '' : percent + '%';
      hint.textContent = note || 'Reste sur cette page jusqu\'à la fin.';
    }

    var preparePhoto = window.isoPhotoPrep.preparePhoto;
    var shrinkIcon = window.isoPhotoPrep.shrinkIcon;

    function send(form, submitter) {
      var buttons = form.querySelectorAll('button, input[type="submit"]');
      var files = Array.prototype.filter.call(form.querySelectorAll('input[type="file"]'), function (i) { return i.name && i.files.length; });
      var isIcon = files.some(function (i) { return i.name === 'icon'; });
      var photos = [];
      files.forEach(function (i) { if (i.name === 'photo') photos = photos.concat(Array.prototype.slice.call(i.files)); });
      var what = photos.length > 1 ? 'des ' + photos.length + ' photos' : 'de la photo';
      var data;
      try { data = new FormData(form, submitter); } catch (e) { data = new FormData(form); }
      data.delete('photo');

      function done() {
        window.removeEventListener('beforeunload', holdPage);
        delete form.dataset.sending;
        buttons.forEach(function (b) { b.disabled = false; });
      }
      function fail(message, retry) {
        done();
        show('L\'envoi n\'a pas abouti', null, message + (retry ? (photos.length > 1 ? ' Tes photos sont toujours choisies' : ' Ta photo est toujours choisie') + ' : touche de nouveau le bouton d\'envoi.' : ''));
        card.classList.add('is-error');
        closeBtn.hidden = false;
        closeBtn.onclick = function () { veil.hidden = true; };
        closeBtn.focus();
      }

      form.dataset.sending = '1';
      buttons.forEach(function (b) { b.disabled = true; });
      window.addEventListener('beforeunload', holdPage);
      show('Préparation ' + what + '…', null);

      // Photos one after the other (decoding many large photos at once would
      // exhaust the phone's memory), each with its thumbnail and details.
      var ready = photos.reduce(function (previous, file, k) {
        return previous.then(function () {
          if (photos.length > 1) show('Préparation des photos… ' + (k + 1) + ' / ' + photos.length, null);
          return preparePhoto(file).then(function (p) {
            data.append('photo', p.file, p.file.name);
            if (p.view) data.append('photo_view', p.view, p.view.name);
            if (p.thumb) data.append('photo_thumb', p.thumb, p.thumb.name);
            data.append('photo_meta', JSON.stringify(p.meta));
          });
        });
      }, Promise.resolve());
      files.forEach(function (input) {
        if (input.name === 'photo') return;
        ready = ready.then(function () {
          return (input.name === 'icon' ? shrinkIcon(input.files[0]) : Promise.resolve(input.files[0])).then(function (file) {
            data.set(input.name, file, file.name);
          });
        });
      });

      ready.then(function () {
        var xhr = new XMLHttpRequest();
        xhr.open('POST', form.action);
        xhr.setRequestHeader('X-Requested-With', 'upload');
        xhr.timeout = 600000;
        xhr.upload.onprogress = function (event) {
          if (event.lengthComputable) show('Envoi ' + (isIcon && !photos.length ? 'de l\'icône' : what) + '…', Math.round(event.loaded / event.total * 100));
        };
        xhr.upload.onload = function () {
          show(isIcon ? 'Préparation de l\'icône…' : 'Enregistrement…', null, 'Encore quelques secondes : reste sur cette page.');
        };
        xhr.onload = function () {
          var answer = null;
          try { answer = JSON.parse(xhr.responseText); } catch (e) {}
          if (xhr.status < 300 && answer && answer.location) {
            window.removeEventListener('beforeunload', holdPage);
            location.assign(answer.location);
            return;
          }
          var text = String(xhr.responseText || '').trim();
          fail(text && text.length < 300 && text.indexOf('<') === -1 ? text : 'Le Pi a répondu par une erreur (' + xhr.status + ').', xhr.status >= 500);
        };
        xhr.onerror = xhr.ontimeout = function () { fail('La connexion avec le Pi a été coupée.', true); };
        xhr.send(data);
      });
    }

    // Photos and videos of a form marked data-envoi go into the sending queue
    // (public/js/envois.js): any number, one at a time, resumed after a cut.
    // The form is emptied at once; a pill shows the progress on every page.
    // Where they go: the form's fiche, else its bac, else data-envoi.
    function queue(form, files) {
      var f = form.elements;
      var fiche = f.fiche_id && f.fiche_id.value;
      var bac = f.bac_id && f.bac_id.value;
      var dest = fiche ? 'fiche:' + fiche : bac ? 'bac:' + bac : form.dataset.envoi;
      var checked = form.querySelector('[name="type"]:checked') || (f.type && f.type.value ? f.type : null);
      var tell = function (text) {
        var toast = document.getElementById('toast');
        if (!toast) return;
        toast.textContent = text;
        toast.hidden = false;
        setTimeout(function () { toast.hidden = true; }, 4500);
      };
      var emptyForm = function () {
        form.reset();
        form.querySelectorAll('input[type="file"]').forEach(function (input) { input.dispatchEvent(new Event('change', { bubbles: true })); });
      };
      // First, the files already in the app (the person chooses), then the queue.
      show('Vérification des doublons…', null, 'Chaque fichier est comparé à ceux déjà dans l’app.');
      var screened = window.isoEnvois.screen(files, function (i, total) {
        show('Vérification des doublons… ' + i + ' / ' + total, null, 'Chaque fichier est comparé à ceux déjà dans l’app.');
      }).catch(function () {
        // Can't check (old browser): everything goes.
        return { files: files, hashes: [], repeated: 0, skipped: 0 };
      });
      screened.then(function (chosen) {
        veil.hidden = true;
        if (!chosen) return;
        var extra = (chosen.repeated ? ' ' + chosen.repeated + ' en double dans ta sélection, gardé' + (chosen.repeated > 1 ? 's' : '') + ' une fois.' : '')
          + (chosen.skipped ? ' ' + chosen.skipped + ' déjà dans l’app, pas renvoyé' + (chosen.skipped > 1 ? 's' : '') + '.' : '');
        var n = chosen.files.length;
        if (!n) {
          emptyForm();
          tell('Rien à envoyer.' + extra);
          return;
        }
        show('Préparation de ' + (n > 1 ? n + ' fichiers' : '1 fichier') + '…', null, 'Ils sont gardés dans le téléphone, puis envoyés un par un.');
        window.isoEnvois.add(chosen.files, { dest: dest, type: checked ? checked.value : 'observation', note: f.note ? f.note.value : '', hashes: chosen.hashes }).then(function () {
          veil.hidden = true;
          emptyForm();
          tell((n > 1 ? n + ' fichiers partent' : 'Le fichier part') + ' vers le Pi : suis l’envoi en bas de l’écran.' + extra);
        });
      });
    }

    document.addEventListener('submit', function (event) {
      var form = event.target;
      if (event.defaultPrevented || !form.matches('form[enctype="multipart/form-data"]')) return;
      var hasFile = Array.prototype.some.call(form.querySelectorAll('input[type="file"]'), function (i) { return i.files.length; });
      if (!hasFile || !window.FormData || !window.XMLHttpRequest) return;
      event.preventDefault();
      if (form.hasAttribute('data-envoi') && window.isoEnvois && window.indexedDB) {
        var files = [];
        form.querySelectorAll('input[type="file"][name="photo"]').forEach(function (i) { files = files.concat(Array.prototype.slice.call(i.files)); });
        return queue(form, files);
      }
      if (!form.dataset.sending) send(form, event.submitter);
    });
  })();

  // Photos choisies : un aperçu de chacune sous le bouton, avec une croix pour
  // en retirer une avant l'envoi. Le bouton dit combien il y en a.
  (function () {
    var urls = new WeakMap();

    function render(input) {
      var form = input.form;
      var box = form && form.querySelector('[data-photo-preview]');
      var label = form && form.querySelector('[data-photo-label]');
      var n = input.files.length;
      if (label) {
        if (!label.dataset.empty) label.dataset.empty = label.textContent;
        label.textContent = n ? (n > 1 ? n + ' fichiers choisis' : '1 fichier choisi') + ' · en ajouter' : label.dataset.empty;
      }
      if (!box) return;
      (urls.get(box) || []).forEach(URL.revokeObjectURL);
      box.innerHTML = '';
      box.hidden = !n;
      var made = Array.prototype.map.call(input.files, function (file, k) {
        var url = URL.createObjectURL(file);
        var tile = document.createElement('div');
        tile.className = 'photo-preview__tile';
        var video = /^video\//.test(file.type);
        tile.innerHTML = (video ? '<video muted playsinline preload="metadata"></video><span class="photo-preview__play">▶</span>' : '<img alt="" loading="lazy" decoding="async">')
          + '<button type="button" class="photo-preview__remove" aria-label="Retirer ce fichier">×</button>';
        tile.firstChild.src = url;
        tile.lastChild.addEventListener('click', function () {
          var kept = new DataTransfer();
          Array.prototype.forEach.call(input.files, function (f, j) { if (j !== k) kept.items.add(f); });
          input.files = kept.files;
          render(input);
        });
        box.appendChild(tile);
        return url;
      });
      urls.set(box, made);
    }

    // Choosing again adds to the photos already chosen instead of replacing
    // them, so several trips to the phone's gallery add up.
    var before = new WeakMap();
    document.addEventListener('click', function (event) {
      var el = event.target.closest && event.target.closest('label, input[type="file"]');
      var input = el && (el.matches('input') ? el : el.querySelector('input[type="file"]'));
      if (input && input.matches('[data-photo-input][multiple]')) before.set(input, Array.prototype.slice.call(input.files));
    }, true);
    document.addEventListener('change', function (event) {
      var input = event.target;
      if (!input.matches || !input.matches('input[type="file"][data-photo-input]')) return;
      var earlier = before.get(input) || [];
      before.delete(input);
      if (input.multiple && earlier.length && window.DataTransfer) {
        var all = new DataTransfer();
        earlier.concat(Array.prototype.slice.call(input.files)).forEach(function (f) { all.items.add(f); });
        input.files = all.files;
      }
      render(input);
    });
  })();

  // Visionneuse : une photo en plein écran, qu'on fait défiler du doigt
  // (glisser à gauche ou à droite, vers le bas pour fermer), qu'on agrandit en
  // écartant deux doigts ou d'un double appui. Elle s'ouvre sur toute vignette
  // [data-photo] et passe d'une photo à l'autre dans son [data-photo-group].
  // Le bouton retour du téléphone la ferme.
  (function () {
    var view, img, list = [], index = 0, opened = false;
    var zoom = { s: 1, x: 0, y: 0 };
    var ICON = {
      tag: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M3.5 12.5V4h8.5l8.5 8.5-8.5 8.5z"/><circle cx="8" cy="8.5" r="1.4"/></svg>',
      share: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="M8.2 10.8l7.6-4.4M8.2 13.2l7.6 4.4"/></svg>',
      sheet: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><path d="M9 12h7M9 16h5"/></svg>',
      save: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5"/><path d="M5 20h14"/></svg>',
      trash: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>'
    };

    function say(message) {
      var toast = document.getElementById('toast');
      toast.textContent = message;
      toast.hidden = false;
      clearTimeout(say.timer);
      say.timer = setTimeout(function () { toast.hidden = true; }, 2800);
    }

    function post(url, body) {
      return fetch(url, {
        method: 'POST',
        headers: body ? { 'X-Requested-With': 'fetch', 'Content-Type': 'application/json' } : { 'X-Requested-With': 'fetch' },
        body: body ? JSON.stringify(body) : undefined
      }).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
    }

    function build() {
      view = document.createElement('div');
      view.className = 'viewer';
      view.hidden = true;
      view.setAttribute('role', 'dialog');
      view.setAttribute('aria-modal', 'true');
      view.setAttribute('aria-label', 'Photo');
      view.innerHTML = '<div class="viewer__stage"><img class="viewer__img" alt="" draggable="false"><video class="viewer__video" controls playsinline preload="metadata" hidden></video></div>'
        + '<div class="viewer__bar"><span class="viewer__count"></span><button type="button" class="viewer__close" data-v="close" aria-label="Fermer">×</button></div>'
        + '<button type="button" class="viewer__nav viewer__nav--prev" data-v="prev" aria-label="Photo précédente">‹</button>'
        + '<button type="button" class="viewer__nav viewer__nav--next" data-v="next" aria-label="Photo suivante">›</button>'
        + '<div class="viewer__info"><div class="viewer__when"></div>'
        + '<div class="viewer__stars" role="group" aria-label="Note de la photo">'
        + [1, 2, 3, 4, 5].map(function (n) { return '<button type="button" data-v="rate" data-stars="' + n + '" aria-label="' + n + ' étoile' + (n > 1 ? 's' : '') + '">★</button>'; }).join('')
        + '</div><a class="viewer__where"></a><p class="viewer__note"></p>'
        + '<div class="viewer__panel" hidden></div>'
        + '<div class="viewer__actions">'
        + '<button type="button" data-v="species">' + ICON.tag + '<span>Espèces</span></button>'
        + '<button type="button" data-v="share">' + ICON.share + '<span>Partager</span></button>'
        + '<button type="button" data-v="sheet">' + ICON.sheet + '<span>Fiche client</span></button>'
        + '<a data-v="save" download>' + ICON.save + '<span>Enregistrer</span></a>'
        + '<button type="button" data-v="delete">' + ICON.trash + '<span>Supprimer</span></button>'
        + '</div><div class="viewer__choice" hidden></div></div>';
      document.body.appendChild(view);
      img = view.querySelector('.viewer__img');
      view.addEventListener('click', onClick);
      gestures(view.querySelector('.viewer__stage'));
      document.addEventListener('keydown', function (event) {
        if (!opened) return;
        if (event.key === 'Escape') close();
        else if (event.key === 'ArrowRight') go(1);
        else if (event.key === 'ArrowLeft') go(-1);
      });
      window.addEventListener('popstate', function () { if (opened) close(true); });
    }

    function pics(p) {
      var cat = window.isoCatIcons || {};
      return p.species.slice(0, 3).map(function (s) {
        return s.pic.charAt(0) === '/' ? '<img src="' + s.pic.replace(/"/g, '&quot;') + '" alt="" class="species-icon-img">' : (cat[s.pic] || cat.autre || '');
      }).join('');
    }

    function render() {
      var p = list[index];
      view.querySelector('.viewer__count').textContent = list.length > 1 ? (index + 1) + ' / ' + list.length : '';
      view.querySelector('.viewer__when').textContent = p.taken ? 'Prise le ' + p.taken : '';
      var where = view.querySelector('.viewer__where');
      where.innerHTML = '<span class="viewer__pics">' + pics(p) + '</span><span></span>';
      where.lastChild.textContent = p.species.map(function (s) { return s.name; }).join(', ') + (p.bacLabel ? ' · ' + p.bacLabel : '');
      if (p.bac) where.href = '/bacs/' + p.bac; else where.removeAttribute('href');
      var note = view.querySelector('.viewer__note');
      note.textContent = [p.type, p.note].filter(Boolean).join(' — ');
      note.hidden = !note.textContent;
      view.querySelectorAll('[data-v="rate"]').forEach(function (b) {
        var n = Number(b.dataset.stars);
        b.classList.toggle('is-on', n <= p.rating);
        b.setAttribute('aria-pressed', n === p.rating ? 'true' : 'false');
      });
      var onSheet = p.species.some(function (s) { return s.showcase; });
      var sheet = view.querySelector('[data-v="sheet"]');
      sheet.classList.toggle('is-on', onSheet);
      sheet.lastChild.textContent = onSheet ? 'Sur la fiche' : 'Fiche client';
      sheet.hidden = !p.species.length || Boolean(p.video);
      var save = view.querySelector('[data-v="save"]');
      save.href = p.full;
      save.setAttribute('download', 'isoterra-' + (p.video ? 'video' : 'photo') + '-' + p.id + (p.full.match(/\.[a-z0-9]+$/i) || ['.jpg'])[0]);
      view.querySelector('.viewer__choice').hidden = true;
      speciesPanel(p);
      view.querySelector('[data-v="prev"]').hidden = index === 0;
      view.querySelector('[data-v="next"]').hidden = index === list.length - 1;
    }

    // The thumbnail at once, then the copy made for viewing; the original,
    // in full detail, once the photo is zoomed in (sharpen).
    function load() {
      var p = list[index];
      reset();
      delete img.dataset.sharp;
      var player = view.querySelector('.viewer__video');
      view.classList.toggle('is-video', Boolean(p.video));
      img.hidden = Boolean(p.video);
      player.hidden = !p.video;
      player.pause();
      if (p.video) {
        // A video plays with its own controls (swipes stay for photos).
        img.removeAttribute('src');
        if (p.thumb && p.thumb !== p.full) player.poster = p.thumb; else player.removeAttribute('poster');
        player.src = p.full;
        render();
        return;
      }
      player.removeAttribute('src');
      player.load();
      img.src = p.thumb;
      img.classList.add('is-loading');
      var shown = new Image();
      shown.onload = function () {
        if (list[index] !== p || img.dataset.sharp) return;
        img.src = shown.src;
        img.classList.remove('is-loading');
      };
      shown.src = p.view || p.full;
      [list[index + 1], list[index - 1]].forEach(function (n) { if (n && !n.video) new Image().src = n.view || n.full; });
      render();
    }

    function sharpen() {
      var p = list[index];
      if (!p || !p.view || p.view === p.full || img.dataset.sharp) return;
      img.dataset.sharp = '1';
      var original = new Image();
      original.onload = function () {
        if (list[index] !== p) return;
        img.src = p.full;
        img.classList.remove('is-loading');
      };
      original.src = p.full;
    }

    function go(step) {
      var next = index + step;
      if (next < 0 || next >= list.length) return;
      index = next;
      load();
    }

    function open(el) {
      if (!view) build();
      var group = el.closest('[data-photo-group]') || document;
      var seen = {};
      list = [];
      Array.prototype.forEach.call(group.querySelectorAll('[data-photo]'), function (t) {
        var p = JSON.parse(t.dataset.photo);
        if (!seen[p.id]) { seen[p.id] = true; list.push(p); }
      });
      var id = JSON.parse(el.dataset.photo).id;
      index = Math.max(0, list.findIndex(function (p) { return p.id === id; }));
      view.hidden = false;
      view.classList.remove('is-bare');
      document.documentElement.classList.add('viewer-open');
      if (!opened) history.pushState({ viewer: true }, '');
      opened = true;
      load();
    }

    function close(fromHistory) {
      if (!opened) return;
      opened = false;
      view.hidden = true;
      document.documentElement.classList.remove('viewer-open');
      img.removeAttribute('src');
      var player = view.querySelector('.viewer__video');
      player.pause();
      player.removeAttribute('src');
      player.load();
      if (!fromHistory) history.back();
    }

    // Every thumbnail of this photo on the page follows a change: its stars
    // and the icons of its species.
    function update(p) {
      document.querySelectorAll('[data-photo-id="' + p.id + '"]').forEach(function (t) {
        t.dataset.photo = JSON.stringify(p);
        var stars = t.querySelector('[data-stars]');
        if (stars) {
          stars.hidden = !p.rating;
          stars.textContent = p.rating + '★';
          stars.classList.toggle('is-top', p.rating === 5);
        }
        var who = t.querySelector('.photo-thumb__who');
        if (who) { who.innerHTML = pics(p); who.hidden = !p.species.length; }
      });
    }

    // The species seen on the photo, to tick among all those of the guide
    // (those of its bac first). Shown while the "Espèces" button is on.
    var guide = {};
    function speciesPanel(p) {
      var panel = view.querySelector('.viewer__panel');
      if (panel.hidden) return;
      var key = p.bac || 0;
      if (!guide[key]) {
        panel.innerHTML = '<p class="viewer__panel-wait">Chargement des espèces…</p>';
        fetch('/photos/especes.json' + (p.bac ? '?bac=' + p.bac : ''))
          .then(function (r) { return r.json(); })
          .then(function (all) { guide[key] = all; if (list[index] === p) speciesPanel(p); })
          .catch(function () { panel.innerHTML = '<p class="viewer__panel-wait">Le Pi n\'a pas répondu.</p>'; });
        return;
      }
      var cat = window.isoCatIcons || {};
      var on = {};
      p.species.forEach(function (s) { on[s.id] = true; });
      var html = '<div class="viewer__panel-head">Qui voit-on sur cette photo ?</div>';
      var group = null;
      guide[key].forEach(function (s) {
        if (s.group !== group) {
          html += (group === null ? '' : '</div>') + '<div class="viewer__panel-group">' + s.group + '</div><div class="viewer__chips">';
          group = s.group;
        }
        var icon = s.pic.charAt(0) === '/' ? '<img src="' + s.pic.replace(/"/g, '&quot;') + '" alt="" class="species-icon-img">' : (cat[s.pic] || cat.autre || '');
        html += '<button type="button" class="viewer__chip' + (on[s.id] ? ' is-on' : '') + '" data-v="tag" data-species="' + s.id + '" aria-pressed="' + (on[s.id] ? 'true' : 'false') + '">'
          + '<span class="viewer__chip-icon">' + icon + '</span><span class="viewer__chip-name"></span></button>';
      });
      panel.innerHTML = html + '</div>';
      guide[key].forEach(function (s) {
        var chip = panel.querySelector('[data-species="' + s.id + '"] .viewer__chip-name');
        if (chip) chip.textContent = s.name;
      });
    }

    function share(p) {
      var title = p.species.map(function (s) { return s.name; }).join(', ');
      fetch(p.full).then(function (r) { return r.blob(); }).then(function (blob) {
        var file = new File([blob], 'isoterra-' + (p.video ? 'video' : 'photo') + '-' + p.id + (p.full.match(/\.[a-z0-9]+$/i) || ['.jpg'])[0], { type: blob.type || 'image/jpeg' });
        if (navigator.canShare && navigator.canShare({ files: [file] })) return navigator.share({ files: [file], title: title, text: p.note || title });
        say('Le partage n\'est pas possible ici : utilise « Enregistrer ».');
      }).catch(function (err) {
        if (!err || err.name !== 'AbortError') say('Le partage n\'a pas abouti.');
      });
    }

    function chooseSheet(p, s) {
      post('/photos/' + p.id + '/fiche-client', { species_id: s.id }).then(function (answer) {
        Object.assign(p, answer.photo);
        // A species shows one photo: others of this page lose that place.
        if (answer.chosen) list.forEach(function (q) {
          if (q !== p) q.species.forEach(function (other) { if (other.id === s.id && other.showcase) { other.showcase = false; update(q); } });
        });
        update(p);
        render();
        say(answer.message);
      }).catch(function () { say('Le Pi n\'a pas répondu.'); });
    }

    function onClick(event) {
      var target = event.target.closest('[data-v]');
      if (!target) return;
      var p = list[index];
      var action = target.dataset.v;
      if (action === 'close') close();
      else if (action === 'prev') go(-1);
      else if (action === 'next') go(1);
      else if (action === 'rate') {
        // Touching the photo's own number of stars again takes them off.
        var before = p.rating;
        var stars = Number(target.dataset.stars) === before ? 0 : Number(target.dataset.stars);
        p.rating = stars;
        update(p);
        render();
        post('/photos/' + p.id + '/note', { rating: stars }).then(function (answer) {
          Object.assign(p, answer.photo);
          update(p);
          say(stars ? stars + (stars > 1 ? ' étoiles' : ' étoile') : 'Note retirée');
        }).catch(function () {
          p.rating = before;
          update(p);
          render();
          say('Le Pi n\'a pas répondu.');
        });
      } else if (action === 'species') {
        var panel = view.querySelector('.viewer__panel');
        panel.hidden = !panel.hidden;
        target.classList.toggle('is-on', !panel.hidden);
        view.querySelector('.viewer__choice').hidden = true;
        speciesPanel(p);
      } else if (action === 'tag') {
        var id = Number(target.dataset.species);
        var add = !p.species.some(function (s) { return s.id === id; });
        target.classList.toggle('is-on', add);
        post('/photos/' + p.id + '/especes', { species_id: id, on: add }).then(function (answer) {
          Object.assign(p, answer.photo);
          update(p);
          render();
        }).catch(function () {
          target.classList.toggle('is-on', !add);
          say('Le Pi n\'a pas répondu.');
        });
      } else if (action === 'share') share(p);
      else if (action === 'sheet') {
        if (p.species.length === 1) return chooseSheet(p, p.species[0]);
        var box = view.querySelector('.viewer__choice');
        box.innerHTML = '<span>Sur la fiche client de :</span>';
        p.species.forEach(function (s) {
          var b = document.createElement('button');
          b.type = 'button';
          b.textContent = (s.showcase ? '✓ ' : '') + s.name;
          b.addEventListener('click', function () { chooseSheet(p, s); });
          box.appendChild(b);
        });
        box.hidden = !box.hidden;
      } else if (action === 'delete') {
        if (!confirm('Supprimer cette photo ? Elle disparaît aussi du journal.')) return;
        post('/photos/' + p.id + '/supprimer').then(function () {
          document.querySelectorAll('[data-photo-id="' + p.id + '"]').forEach(function (t) { t.remove(); });
          list.splice(index, 1);
          say('Photo supprimée');
          if (!list.length) return close();
          index = Math.min(index, list.length - 1);
          load();
        }).catch(function () { say('Le Pi n\'a pas répondu.'); });
      }
    }

    // Zoom and swipes, with the finger(s) on the photo.
    function reset() {
      zoom = { s: 1, x: 0, y: 0 };
      img.style.transform = '';
      img.style.opacity = '';
    }

    function apply() {
      var w = img.offsetWidth, h = img.offsetHeight;
      var stage = img.parentNode.getBoundingClientRect();
      var maxX = Math.max(0, (w * zoom.s - stage.width) / 2), maxY = Math.max(0, (h * zoom.s - stage.height) / 2);
      zoom.x = Math.max(-maxX, Math.min(maxX, zoom.x));
      zoom.y = Math.max(-maxY, Math.min(maxY, zoom.y));
      img.style.transform = 'translate(' + zoom.x + 'px,' + zoom.y + 'px) scale(' + zoom.s + ')';
      if (zoom.s > 1.4) sharpen();
    }

    function gestures(stage) {
      var points = {}, start = null, pinch = null, lastTap = 0, tapTimer;
      var center = function (e) {
        var r = stage.getBoundingClientRect();
        return { x: e.clientX - r.left - r.width / 2, y: e.clientY - r.top - r.height / 2 };
      };
      var pair = function () { var k = Object.keys(points); return [points[k[0]], points[k[1]]]; };

      stage.addEventListener('pointerdown', function (e) {
        if (e.target.closest && e.target.closest('video')) return;
        points[e.pointerId] = { x: e.clientX, y: e.clientY };
        try { stage.setPointerCapture(e.pointerId); } catch (err) { /* finger already gone */ }
        var n = Object.keys(points).length;
        if (n === 1) start = { x: e.clientX, y: e.clientY, zx: zoom.x, zy: zoom.y, t: Date.now(), moved: false };
        if (n === 2) {
          var p = pair();
          var mid = center({ clientX: (p[0].x + p[1].x) / 2, clientY: (p[0].y + p[1].y) / 2 });
          pinch = { d: Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y), s: zoom.s, x: zoom.x, y: zoom.y, mid: mid };
          if (start) start.moved = true;
        }
        img.classList.add('is-dragging');
      });

      stage.addEventListener('pointermove', function (e) {
        if (!points[e.pointerId]) return;
        points[e.pointerId] = { x: e.clientX, y: e.clientY };
        if (pinch && Object.keys(points).length >= 2) {
          var p = pair();
          var s = Math.max(1, Math.min(5, pinch.s * Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y) / pinch.d));
          zoom.x = pinch.mid.x - (pinch.mid.x - pinch.x) * s / pinch.s;
          zoom.y = pinch.mid.y - (pinch.mid.y - pinch.y) * s / pinch.s;
          zoom.s = s;
          apply();
          return;
        }
        if (!start) return;
        var dx = e.clientX - start.x, dy = e.clientY - start.y;
        if (Math.abs(dx) > 8 || Math.abs(dy) > 8) start.moved = true;
        if (zoom.s > 1) {
          zoom.x = start.zx + dx;
          zoom.y = start.zy + dy;
          apply();
        } else if (Math.abs(dy) > Math.abs(dx) && dy > 0) {
          img.style.transform = 'translateY(' + dy + 'px)';
          img.style.opacity = String(Math.max(0.3, 1 - dy / 400));
        } else {
          img.style.transform = 'translateX(' + dx + 'px)';
        }
      });

      function end(e) {
        if (!points[e.pointerId]) return;
        delete points[e.pointerId];
        var left = Object.keys(points).length;
        img.classList.remove('is-dragging');
        if (pinch) {
          if (left < 2) pinch = null;
          if (zoom.s < 1.05) reset();
          if (left === 1) {
            var k = Object.keys(points)[0];
            start = { x: points[k].x, y: points[k].y, zx: zoom.x, zy: zoom.y, t: Date.now(), moved: true };
          } else start = null;
          return;
        }
        if (!start || left) return;
        var dx = e.clientX - start.x, dy = e.clientY - start.y;
        var tap = !start.moved && Date.now() - start.t < 300;
        start = null;
        if (tap) {
          // Double tap: zoom in where it was tapped, or back out. Single tap:
          // hide or show the bars around the photo.
          if (Date.now() - lastTap < 300) {
            clearTimeout(tapTimer);
            lastTap = 0;
            if (zoom.s > 1) reset();
            else {
              var c = center(e);
              zoom.s = 2.5;
              zoom.x = -c.x * 1.5;
              zoom.y = -c.y * 1.5;
              apply();
            }
          } else {
            lastTap = Date.now();
            tapTimer = setTimeout(function () { view.classList.toggle('is-bare'); }, 300);
          }
          return;
        }
        if (zoom.s > 1) return;
        if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) {
          var before = index;
          go(dx < 0 ? 1 : -1);
          if (index === before) reset();
        } else if (dy > 110 && Math.abs(dy) > Math.abs(dx)) close();
        else reset();
      }
      stage.addEventListener('pointerup', end);
      stage.addEventListener('pointercancel', end);
    }

    document.addEventListener('click', function (event) {
      var thumb = event.target.closest && event.target.closest('[data-photo]');
      if (!thumb) return;
      event.preventDefault();
      open(thumb);
    });
  })();

  // Menus d'espèces avec icônes : un <select> natif ne sait pas afficher
  // d'images, alors chaque <select data-picker> reste en place (formulaire,
  // scripts de la page) mais s'affiche comme un bouton qui ouvre la liste dans
  // un panneau. Chaque option donne ses images dans data-pics, séparées par
  // « | » : le chemin d'une icône, ou une catégorie pour le dessin par défaut.
  (function () {
    var CAT_ICONS = <%- JSON.stringify(icons.categoryIcons(28)).replace(/</g, '\\u003c') %>;
    window.isoCatIcons = CAT_ICONS;
    var sheet, list, title;

    function picsHtml(pics) {
      return String(pics || '').split('|').filter(Boolean).slice(0, 4).map(function (p) {
        if (p.charAt(0) === '/') return '<img src="' + p.replace(/"/g, '&quot;') + '" alt="" class="species-icon-img" decoding="async">';
        return CAT_ICONS[p] || CAT_ICONS.autre;
      }).join('');
    }

    function labelFor(select) {
      var field = select.closest('.field');
      var label = field && field.querySelector('label');
      return select.getAttribute('aria-label') || (label && label.textContent.trim()) || 'Choisir';
    }

    function ensureSheet() {
      if (sheet) return;
      sheet = document.createElement('dialog');
      sheet.className = 'picker-sheet';
      sheet.innerHTML = '<div class="picker-sheet__head"><span class="picker-sheet__title"></span>'
        + '<button type="button" class="picker-sheet__close" aria-label="Fermer">&times;</button></div>'
        + '<div class="picker-sheet__list" role="listbox"></div>';
      document.body.appendChild(sheet);
      list = sheet.querySelector('.picker-sheet__list');
      title = sheet.querySelector('.picker-sheet__title');
      sheet.querySelector('.picker-sheet__close').addEventListener('click', function () { sheet.close(); });
      // A tap on the dimmed backdrop closes it too.
      sheet.addEventListener('click', function (event) { if (event.target === sheet) sheet.close(); });
    }

    function open(select) {
      ensureSheet();
      title.textContent = labelFor(select);
      list.innerHTML = '';
      var chosen = null;
      function add(opt) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'picker-opt';
        b.setAttribute('role', 'option');
        b.setAttribute('aria-selected', opt.selected ? 'true' : 'false');
        b.disabled = opt.disabled;
        b.innerHTML = '<span class="picker-pics">' + picsHtml(opt.dataset.pics) + '</span><span class="picker-opt__label"></span>';
        b.lastChild.textContent = opt.textContent.trim();
        b.addEventListener('click', function () {
          sheet.close();
          if (select.value === opt.value) return;
          select.value = opt.value;
          select.dispatchEvent(new Event('change', { bubbles: true }));
        });
        if (opt.selected) chosen = b;
        list.appendChild(b);
      }
      Array.prototype.forEach.call(select.children, function (node) {
        if (node.tagName === 'OPTGROUP') {
          var head = document.createElement('div');
          head.className = 'picker-sheet__group';
          head.textContent = node.label;
          list.appendChild(head);
          Array.prototype.forEach.call(node.children, add);
        } else if (node.tagName === 'OPTION') {
          add(node);
        }
      });
      sheet.showModal();
      if (chosen) {
        chosen.scrollIntoView({ block: 'center' });
        chosen.focus({ preventScroll: true });
      }
    }

    function enhance(select) {
      if (select.dataset.pickerReady) return;
      select.dataset.pickerReady = '1';
      var wrap = document.createElement('span');
      wrap.className = 'picker';
      select.parentNode.insertBefore(wrap, select);
      wrap.appendChild(select);
      var button = document.createElement('button');
      button.type = 'button';
      button.className = 'picker-btn';
      button.setAttribute('aria-haspopup', 'dialog');
      wrap.appendChild(button);
      select.classList.add('picker-native');
      select.tabIndex = -1;
      select.setAttribute('aria-hidden', 'true');

      function sync() {
        var opt = select.options[select.selectedIndex];
        var text = opt ? opt.textContent.trim() : '';
        button.innerHTML = '<span class="picker-pics">' + picsHtml(opt && opt.dataset.pics) + '</span><span class="picker-btn__label"></span>';
        button.lastChild.textContent = text;
        button.setAttribute('aria-label', labelFor(select) + ' : ' + text);
      }
      select._pickerSync = sync;
      select.addEventListener('change', sync);
      button.addEventListener('click', function () { open(select); });
      sync();
    }

    window.isoPicker = {
      enhance: function (root) {
        root = root || document;
        if (root.matches && root.matches('select[data-picker]')) enhance(root);
        root.querySelectorAll('select[data-picker]').forEach(enhance);
      }
    };
    window.isoPicker.enhance();
    // Values the browser restores on "back" arrive without a change event.
    window.addEventListener('pageshow', function () {
      document.querySelectorAll('select[data-picker-ready]').forEach(function (s) { s._pickerSync(); });
    });
  })();
</script>
</body>
</html>
