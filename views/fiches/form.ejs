<%- include('../partials/header', { title, active: active || 'fiches' }) %>

<div class="masthead">
  <div>
    <div class="eyebrow">REGISTRE DES BACS</div>
    <h1><%= isNew ? 'Nouveau bac' : 'Modifier la fiche' %></h1>
  </div>
</div>
<div class="rule-double"></div>
<div class="rule-thin"></div>

<form method="POST" action="<%= isNew ? '/fiches' : '/fiches/' + bac.id %>" style="max-width:560px;">
  <div class="field">
    <label>Espèce</label>
    <select name="species_id" required>
      <option value="">— choisir —</option>
      <% let currentCat = null; %>
      <% speciesList.forEach(function(sp) { %>
        <% if (sp.category !== currentCat) { if (currentCat !== null) { %></optgroup><% } %><optgroup label="<%= sp.category %>"><% currentCat = sp.category; } %>
        <option value="<%= sp.id %>" <%= String(bac.species_id) === String(sp.id) ? 'selected' : '' %>><%= sp.common_name %> (<%= sp.scientific_name %>)</option>
      <% }); %>
      <% if (currentCat !== null) { %></optgroup><% } %>
    </select>
  </div>

  <div class="field">
    <label>Morph (optionnel)</label>
    <input type="text" name="morph" value="<%= bac.morph || '' %>" placeholder="ex. Dairy Cow">
  </div>

  <div class="field">
    <label>Lignée</label>
    <input type="text" name="lineage" value="<%= bac.lineage || '' %>" placeholder="ex. F3 — groupe fondateur A2">
  </div>

  <div class="field">
    <label>Population (estimation)</label>
    <input type="text" name="population_estimate" value="<%= bac.population_estimate || '' %>" placeholder="ex. ~38 individus">
  </div>

  <div class="field">
    <label>Substrat</label>
    <input type="text" name="substrate" value="<%= bac.substrate || '' %>" placeholder="ex. Terreau feuilles et écorce">
  </div>

  <div class="field">
    <label>Date d'acquisition</label>
    <input type="date" name="acquisition_date" value="<%= bac.acquisition_date || '' %>">
  </div>

  <div class="field">
    <label>Statut</label>
    <select name="status">
      <option value="actif" <%= bac.status === 'actif' ? 'selected' : '' %>>Actif</option>
      <option value="reproduction" <%= bac.status === 'reproduction' ? 'selected' : '' %>>Reproduction</option>
      <option value="vente" <%= bac.status === 'vente' ? 'selected' : '' %>>En vente</option>
    </select>
  </div>

  <% if (!isNew) { %>
  <div class="field">
    <label>Étape de reproduction (pour le suivi des pontes)</label>
    <select name="breeding_stage">
      <option value="">— aucune —</option>
      <option value="accouplement" <%= bac.breeding_stage === 'accouplement' ? 'selected' : '' %>>Accouplement observé</option>
      <option value="ponte" <%= bac.breeding_stage === 'ponte' ? 'selected' : '' %>>Ponte confirmée</option>
      <option value="incubation" <%= bac.breeding_stage === 'incubation' ? 'selected' : '' %>>Incubation</option>
      <option value="naissance" <%= bac.breeding_stage === 'naissance' ? 'selected' : '' %>>Naissances récentes</option>
    </select>
  </div>

  <div class="field">
    <label>Quantité disponible à la vente</label>
    <input type="number" name="for_sale_quantity" min="0" value="<%= bac.for_sale_quantity || 0 %>">
  </div>

  <div class="field">
    <label>Prix unitaire (€)</label>
    <input type="number" step="0.5" min="0" name="unit_price" value="<%= bac.unit_price || '' %>">
  </div>
  <% } %>

  <button type="submit" class="btn"><%= isNew ? 'Créer la fiche' : 'Enregistrer' %></button>
</form>

<%- include('../partials/footer') %>
