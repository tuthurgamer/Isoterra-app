<%- include('../partials/header', { title, active }) %>

<div class="masthead masthead--home">
  <div class="brand-block">
    <img src="/icons/logo.png" alt="" class="brand-logo" width="640" height="443">
    <div>
    <div class="wordmark brand">ISOTERRA</div>
    <div class="subtitle tagline">Carnet d'élevage et registre professionnel</div>
    </div>
  </div>
  <div class="home-tools">
    <a href="/rappels" class="server-link" aria-label="Rappels sur le téléphone"><%- icons.nav('rappels') %><span>Rappels</span></a>
    <a href="/serveur" class="server-link" aria-label="Serveur : état du Pi et de l'app"><%- icons.nav('serveur') %><span>Serveur</span></a>
    <div class="stamp stamp--muted date-stamp"><%= fmt.dateFr(new Date().toISOString()) %></div>
  </div>
</div>
<div class="rule-double"></div>
<div class="rule-thin"></div>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="notice" role="status"><%= notice %></div>
  <script>history.replaceState(null, '', location.pathname);</script>
<% } %>

<% if (bacs.length > 0) { %>
<section class="todo" id="a-faire" data-todo>
  <div class="todo__head">
    <h2>À faire aujourd'hui</h2>
    <span class="todo__count" data-todo-count><%= todo.length ? todo.length + ' bac' + (todo.length > 1 ? 's' : '') : '' %></span>
  </div>
  <p class="todo__empty" data-todo-empty<%= todo.length ? ' hidden' : '' %>>Tout est à jour : rien à faire aujourd'hui.</p>
  <% if (todo.length) { %>
    <p class="todo__hint" data-todo-hint>Touche une action une fois faite pour la noter.</p>
    <ul class="todo__list">
      <% todo.forEach(function (t, i) { %>
        <li class="todo__row" data-todo-row<%= i >= 5 ? ' data-todo-more hidden' : '' %>>
          <a href="/bacs/<%= t.bac %>" class="todo__bac">
            <span class="todo__pics"><% t.fiches.slice(0, 2).forEach(function (f) { %><%- icons.species(f, 40) %><% }); %></span>
            <span class="todo__name">
              <strong>Bac <%= t.label %></strong>
              <small><%= t.residents %></small>
            </span>
          </a>
          <div class="todo__actions">
            <% [['feed', 'nourrissage', 'Nourrir', 'Nourri'], ['mist', 'pulverisation', 'Pulvériser', 'Pulvérisé']].forEach(function (a) { var need = t[a[0]]; if (!need) return; %>
              <form method="POST" action="/bacs/<%= t.bac %>/log/quick?type=<%= a[1] %>" data-quicklog data-label="<%= fmt.LOG_TYPE_LABELS[a[1]] %>" data-todo-action data-done-text="<%= a[3] %>">
                <button type="submit" class="todo__btn<%= need.late ? ' todo__btn--late' : '' %>">
                  <%- icons.action(a[1]) %><span><%= a[2] %></span><% if (need.late) { %><em>en retard</em><% } %>
                </button>
              </form>
            <% }); %>
          </div>
        </li>
      <% }); %>
    </ul>
    <% if (todo.length > 5) { %>
      <button type="button" class="todo__more" data-todo-show>Voir les <%= todo.length - 5 %> autres bacs</button>
    <% } %>
  <% } %>
</section>
<% } %>

<div class="stat-row">
  <div class="label-tag" style="transform:rotate(-1deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--rust);"><%= stats.total %></div>
    <div class="lbl">bacs actifs</div>
  </div>
  <div class="label-tag" style="transform:rotate(0.8deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--moss);"><%= stats.pulverisationsThisWeek %></div>
    <div class="lbl">pulvérisations cette semaine</div>
  </div>
  <div class="label-tag" style="transform:rotate(-0.5deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--rust);"><%= stats.pontesEnCours %></div>
    <div class="lbl">pontes en cours</div>
  </div>
  <div class="label-tag" style="transform:rotate(1.1deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--stampred);" data-attention-count><%= stats.attention %></div>
    <div class="lbl">en retard ou en alerte</div>
  </div>
</div>

<% if (bacs.length > 0) { %>
<div class="tour-cta">
  <div class="tour-cta__text">
    <div class="wordmark tour-cta__title">La tournée du jour</div>
    <div class="tour-cta__sub"><%= groups.length %> bac<%= groups.length > 1 ? 's' : '' %> à parcourir — un tap par bac</div>
  </div>
  <a href="/tournee" class="tour-cta__btn">Commencer la tournée</a>
</div>
<% } %>

<div class="section-title">
  <h2>Registre des bacs</h2>
  <div class="rule"></div>
  <a href="/fiches/new" class="btn-quiet">+ nouveau bac</a>
  <div class="count"><%= groups.length %> bac<%= groups.length > 1 ? 's' : '' %><%= bacs.length !== groups.length ? ' · ' + bacs.length + ' fiches' : '' %></div>
</div>

<% if (bacs.length === 0) { %>
  <p style="font-style:italic; color:var(--ink-muted);">Aucun bac pour l'instant. <a href="/fiches/new">Ajoute le premier</a>.</p>
<% } %>

<div class="grid-3 bac-grid">
  <% groups.forEach(function (g) { %>
    <% if (g.compat) { %>
      <%- include('_bac-card', { g: g }) %>
    <% } else { %>
      <%- include('_card', { bac: g.fiches[0] }) %>
    <% } %>
  <% }); %>
</div>

<script>
  // "À faire aujourd'hui": an action noted (by the cards' quick-action
  // script) is ticked; a bac with nothing left goes, and the count follows.
  (function () {
    var box = document.querySelector('[data-todo]');
    if (!box) return;
    var more = box.querySelector('[data-todo-show]');
    if (more) {
      more.addEventListener('click', function () {
        box.querySelectorAll('[data-todo-more]').forEach(function (row) { row.hidden = false; });
        more.remove();
      });
    }
    // A bac done makes room: the next hidden one shows.
    function showNext() {
      var visible = box.querySelectorAll('[data-todo-row]:not([hidden])').length;
      var next = box.querySelector('[data-todo-more][hidden]');
      if (visible < 5 && next) next.hidden = false;
      var hiddenLeft = box.querySelectorAll('[data-todo-more][hidden]').length;
      if (more && more.isConnected) {
        if (hiddenLeft) more.textContent = 'Voir les ' + hiddenLeft + ' autres bacs';
        else more.remove();
      }
    }
    box.addEventListener('quicklog:done', function (event) {
      var form = event.target.closest('[data-todo-action]');
      if (!form) return;
      // The button becomes a plain mark, so it can't be noted twice.
      var button = form.querySelector('button');
      var done = document.createElement('span');
      done.className = 'todo__btn todo__btn--done';
      done.innerHTML = button.innerHTML;
      done.querySelector('span').textContent = form.dataset.doneText;
      var late = done.querySelector('em');
      if (late) late.remove();
      button.replaceWith(done);
      var row = form.closest('[data-todo-row]');
      if (row.querySelector('button')) return;
      setTimeout(function () {
        row.classList.add('todo__row--gone');
        setTimeout(function () {
          row.remove();
          showNext();
          var left = box.querySelectorAll('[data-todo-row]').length;
          box.querySelector('[data-todo-count]').textContent = left ? left + ' bac' + (left > 1 ? 's' : '') : '';
          if (!left) {
            box.querySelector('[data-todo-empty]').hidden = false;
            var hint = box.querySelector('[data-todo-hint]');
            if (hint) hint.hidden = true;
          }
        }, 350);
      }, 700);
    });
  })();
</script>

<%- include('../partials/footer') %>
