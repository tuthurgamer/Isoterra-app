<%- include('../partials/header', { title, active }) %>

<div class="masthead">
  <div>
    <div class="wordmark" style="font-size:34px; color:var(--ink);">ISOTERRA</div>
    <div class="subtitle">Carnet d'élevage et registre professionnel</div>
  </div>
  <div class="stamp stamp--muted"><%= fmt.dateFr(new Date().toISOString()) %></div>
</div>
<div class="rule-double"></div>
<div class="rule-thin"></div>

<div style="display:flex; gap:18px; margin-bottom:38px; flex-wrap:wrap;">
  <div class="label-tag" style="transform:rotate(-1deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--rust);"><%= stats.total %></div>
    <div class="lbl">bacs actifs</div>
  </div>
  <div class="label-tag" style="transform:rotate(0.8deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--moss);"><%= stats.muesThisWeek %></div>
    <div class="lbl">mues cette semaine</div>
  </div>
  <div class="label-tag" style="transform:rotate(-0.5deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--rust);"><%= stats.pontesEnCours %></div>
    <div class="lbl">pontes en cours</div>
  </div>
  <div class="label-tag" style="transform:rotate(1.1deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--stampred);"><%= stats.aSurveiller %></div>
    <div class="lbl">à surveiller</div>
  </div>
</div>

<% if (bacs.length > 0) { %>
<div style="display:flex; align-items:center; justify-content:space-between; border:1.5px solid var(--ink); background:var(--paper-alt); padding:16px 22px; margin-bottom:34px;">
  <div>
    <div class="wordmark" style="font-size:16px; color:var(--ink);">La tournée du jour</div>
    <div style="font-style:italic; color:var(--ink-muted); font-size:12.5px; margin-top:2px;"><%= bacs.length %> bac<%= bacs.length > 1 ? 's' : '' %> à parcourir — un tap par bac</div>
  </div>
  <a href="/tournee" style="display:inline-flex; align-items:center; justify-content:center; padding:12px 26px; border:2px solid var(--rust); border-radius:6px; box-shadow:0 0 0 3px var(--paper-alt), 0 0 0 4.5px var(--rust); transform:rotate(-1.5deg); font-family:'IM Fell English SC',serif; letter-spacing:0.06em; color:var(--rust); font-size:14px; white-space:nowrap; text-decoration:none;">
    Commencer la tournée
  </a>
</div>
<% } %>

<div class="section-title">
  <h2>Registre des bacs</h2>
  <div class="rule"></div>
  <a href="/fiches/new" class="btn-quiet">+ nouveau bac</a>
  <div class="count"><%= bacs.length %> fiches</div>
</div>

<% if (bacs.length === 0) { %>
  <p style="font-style:italic; color:var(--ink-muted);">Aucun bac pour l'instant. <a href="/fiches/new">Ajoute le premier</a>.</p>
<% } %>

<div class="grid-3">
  <% bacs.forEach(function(bac) { %>
    <div class="specimen-card">
      <div style="display:flex; justify-content:space-between; align-items:flex-start;">
        <a class="icon" href="/fiches/<%= bac.id %>"><%- icons.species(bac.category) %></a>
        <div class="tag"><%= fmt.numTag(bac.bac_id) %></div>
      </div>
      <a href="/fiches/<%= bac.id %>" style="color:inherit;">
        <div class="name" style="font-style:italic;"><%= bac.scientific_name %><%= bac.morph ? " '" + bac.morph + "'" : '' %></div>
      </a>
      <% if (bac.cohabitants.length) { %>
        <div style="font-size:11px; font-style:italic; color:var(--ink-faint);">cohabite avec <%= bac.cohabitants.join(', ') %></div>
      <% } %>
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <div class="stamp <%= fmt.STATUS_CLASSES[bac.status] || 'stamp--muted' %>"><%= fmt.STATUS_LABELS[bac.status] || bac.status %></div>
        <% if (bac.vigilance && bac.vigilance !== 'Aucune') { %>
          <div class="stamp stamp--red">Vigilance</div>
        <% } %>
      </div>

      <div style="display:flex; gap:6px;">
        <% ['nourrissage','nettoyage','mue','observation'].forEach(function(t) { %>
          <form method="POST" action="/fiches/<%= bac.id %>/log/quick?type=<%= t %>" style="flex:1;">
            <button type="submit" class="btn-quiet" style="width:100%; justify-content:center; border:1px solid var(--line); padding:8px 4px;" title="<%= fmt.LOG_TYPE_LABELS[t] %>">
              <%- icons.action(t) %>
            </button>
          </form>
        <% }); %>
      </div>

      <div class="foot">
        <span><%= bac.population_estimate || '—' %></span>
        <span>obs. <%= fmt.relative(bac.last_log_at) %></span>
      </div>
    </div>
  <% }); %>
</div>

<%- include('../partials/footer') %>
