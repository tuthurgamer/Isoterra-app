<%- include('../partials/header', { title, active }) %>

<div class="masthead masthead--home">
  <div>
    <div class="wordmark brand">ISOTERRA</div>
    <div class="subtitle tagline">Carnet d'élevage et registre professionnel</div>
  </div>
  <div class="home-tools">
    <a href="/serveur" class="server-link" aria-label="Serveur : état du Pi et de l'app"><%- icons.nav('serveur') %><span>Serveur</span></a>
    <div class="stamp stamp--muted date-stamp"><%= fmt.dateFr(new Date().toISOString()) %></div>
  </div>
</div>
<div class="rule-double"></div>
<div class="rule-thin"></div>

<% if (typeof notice !== 'undefined' && notice) { %>
  <div class="notice" role="status"><%= notice %></div>
  <script>history.replaceState(null, '', location.pathname);</script>
<% } %>

<div class="stat-row">
  <div class="label-tag" style="transform:rotate(-1deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--rust);"><%= stats.total %></div>
    <div class="lbl">bacs actifs</div>
  </div>
  <div class="label-tag" style="transform:rotate(0.8deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--moss);"><%= stats.pulverisationsThisWeek %></div>
    <div class="lbl">pulvérisations cette semaine</div>
  </div>
  <div class="label-tag" style="transform:rotate(-0.5deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--rust);"><%= stats.pontesEnCours %></div>
    <div class="lbl">pontes en cours</div>
  </div>
  <div class="label-tag" style="transform:rotate(1.1deg);">
    <div class="pin"></div>
    <div class="num" style="color:var(--stampred);" data-attention-count><%= stats.attention %></div>
    <div class="lbl">en retard ou en alerte</div>
  </div>
</div>

<% if (bacs.length > 0) { %>
<div class="tour-cta">
  <div class="tour-cta__text">
    <div class="wordmark tour-cta__title">La tournée du jour</div>
    <div class="tour-cta__sub"><%= groups.length %> bac<%= groups.length > 1 ? 's' : '' %> à parcourir — un tap par bac</div>
  </div>
  <a href="/tournee" class="tour-cta__btn">Commencer la tournée</a>
</div>
<% } %>

<div class="section-title">
  <h2>Registre des bacs</h2>
  <div class="rule"></div>
  <a href="/fiches/new" class="btn-quiet">+ nouveau bac</a>
  <div class="count"><%= groups.length %> bac<%= groups.length > 1 ? 's' : '' %><%= bacs.length !== groups.length ? ' · ' + bacs.length + ' fiches' : '' %></div>
</div>

<% if (bacs.length === 0) { %>
  <p style="font-style:italic; color:var(--ink-muted);">Aucun bac pour l'instant. <a href="/fiches/new">Ajoute le premier</a>.</p>
<% } %>

<div class="grid-3 bac-grid">
  <% groups.forEach(function (g) { %>
    <% if (g.compat) { %>
      <%- include('_bac-card', { g: g }) %>
    <% } else { %>
      <%- include('_card', { bac: g.fiches[0] }) %>
    <% } %>
  <% }); %>
</div>

<%- include('../partials/footer') %>
