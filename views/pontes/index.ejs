<%- include('../partials/header', { title, active }) %>

<div class="masthead">
  <div>
    <div class="eyebrow">SUIVI DES REPRODUCTIONS</div>
    <h1>Pontes &amp; couvain</h1>
  </div>
  <div class="stamp stamp--muted"><%= fmt.dateFr(new Date().toISOString()) %></div>
</div>
<div class="rule-double"></div>
<div class="rule-thin"></div>

<div style="display:flex; gap:22px; align-items:flex-start; overflow-x:auto;">
  <% columns.forEach(function(col) { %>
    <div style="flex:1; min-width:220px;">
      <div style="font-family:'Special Elite',monospace; font-size:10.5px; letter-spacing:0.04em; color:var(--ink-muted); text-transform:uppercase; padding-bottom:8px; border-bottom:1.5px solid var(--ink); margin-bottom:12px; display:flex; justify-content:space-between;">
        <span><%= col.label %></span><span><%= col.items.length %></span>
      </div>
      <% if (col.items.length === 0) { %>
        <p style="font-style:italic; color:var(--ink-faint); font-size:12px;">—</p>
      <% } %>
      <% col.items.forEach(function(bac) { %>
        <a href="/fiches/<%= bac.id %>" style="display:block; background:var(--paper-alt); border:1px solid var(--line); padding:14px; margin-bottom:12px; color:var(--ink);">
          <div style="font-weight:600; font-size:14px;"><%= bac.common_name %><%= bac.morph ? ' ' + bac.morph : '' %></div>
          <div style="font-style:italic; color:var(--ink-muted); font-size:11.5px; margin-bottom:8px;"><%= bac.scientific_name %> — bac <%= fmt.numTag(bac.id) %></div>
          <div style="font-family:'Special Elite',monospace; font-size:10px; color:var(--ink-muted);">màj <%= fmt.relative(bac.updated_at) %></div>
        </a>
      <% }); %>
    </div>
  <% }); %>
</div>

<%- include('../partials/footer') %>
