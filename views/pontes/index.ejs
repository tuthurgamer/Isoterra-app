<%- include('../partials/header', { title, active }) %>

<div class="masthead">
  <div>
    <div class="eyebrow">SUIVI DES REPRODUCTIONS</div>
    <h1>Pontes &amp; couvain</h1>
  </div>
  <div class="stamp stamp--muted"><%= fmt.dateFr(new Date().toISOString()) %></div>
</div>
<div class="rule-double"></div>
<div class="rule-thin"></div>

<div class="kanban">
  <% columns.forEach(function(col) { %>
    <div class="kanban__col<%= col.items.length === 0 ? ' kanban__col--empty' : '' %>">
      <div class="kanban__head">
        <span><%= col.label %></span><span><%= col.items.length %></span>
      </div>
      <% if (col.items.length === 0) { %>
        <p class="kanban__none">—</p>
      <% } %>
      <% col.items.forEach(function(bac) { %>
        <a href="/fiches/<%= bac.id %>" class="kanban__card">
          <div class="kanban__name"><%= bac.scientific_name %><%= bac.morph ? " '" + bac.morph + "'" : '' %></div>
          <div class="kanban__sub">bac <%= fmt.numTag(bac.bac_id) %></div>
          <div class="kanban__meta">màj <%= fmt.relative(bac.updated_at) %></div>
        </a>
      <% }); %>
    </div>
  <% }); %>
</div>

<%- include('../partials/footer') %>
