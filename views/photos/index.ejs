<%- include('../partials/header', { title, active }) %>

<%
  var speciesById = {};
  speciesList.forEach(function (sp) { speciesById[sp.id] = sp; });
  var bacPics = function (b) {
    return String(b.species_ids || '').split(',').map(function (id) { return speciesById[id]; }).filter(Boolean).map(icons.pic).join('|');
  };
  var plural = function (n, word) { return n + ' ' + word + (n > 1 ? 's' : ''); };
%>

<div class="masthead">
  <div>
    <div class="eyebrow">GALERIE</div>
    <h1>Photos de l'élevage</h1>
    <div class="subtitle"><%= filter.label ? plural(total, 'photo') + ' · ' + filter.label : plural(allCount, 'photo') %></div>
  </div>
  <div class="masthead-actions">
    <a href="/appareil<%= filter.bacId ? '?bac=' + filter.bacId : filter.speciesId ? '?espece=' + filter.speciesId : '' %>" class="btn camera-link"><%- icons.nav('photos') %><span>Appareil photo</span></a>
    <a href="#ajouter" class="btn" data-open-add>+ Ajouter photos ou vidéos</a>
  </div>
</div>
<div class="rule-double"></div>
<div class="rule-thin"></div>

<details class="gallery-add" id="ajouter">
  <summary>Ajouter des photos</summary>
  <form method="POST" action="/photos" enctype="multipart/form-data" class="gallery-add__form" data-envoi>
    <div class="field">
      <label>Bac</label>
      <select name="bac_id" data-picker required>
        <option value="">— choisir le bac —</option>
        <% bacs.forEach(function (b) { %>
          <option value="<%= b.id %>" data-pics="<%= bacPics(b) %>"<%= filter.bacId === b.id ? ' selected' : '' %>>Bac <%= fmt.numTag(b.id) %><%= b.name ? ' « ' + b.name + ' »' : '' %> — <%= b.residents %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label>Note (optionnelle, pour toutes ces photos)</label>
      <textarea name="note" rows="2" placeholder="ex. Première mue des juvéniles"></textarea>
    </div>
    <div class="field">
      <label class="hub-photo">
        <input type="file" name="photo" accept="image/*,video/*" multiple required data-photo-input>
        <span data-photo-label>+ Choisir photos et vidéos</span>
      </label>
    </div>
    <div class="photo-preview" data-photo-preview hidden></div>
    <button type="submit" class="btn">Ajouter</button>
  </form>
</details>

<nav class="gallery-filters" aria-label="Trier et filtrer les photos">
  <span class="gallery-sort">
    <a class="gallery-chip<%= filter.byStars ? '' : ' is-on' %>" href="<%= links.byDate %>">Par date</a>
    <a class="gallery-chip<%= filter.byStars ? ' is-on' : '' %>" href="<%= links.byStars %>">★ Par note</a>
  </span>
  <span class="gallery-filters__pick">
    <select aria-label="Photos d'une espèce" data-picker data-filter="espece">
      <option value="">Toutes les espèces</option>
      <% fmt.speciesGroups(speciesList).forEach(function (group) { %>
        <optgroup label="<%= group.label %>">
          <% group.items.forEach(function (sp) { %>
            <option value="<%= sp.id %>" data-pics="<%= icons.pic(sp) %>" data-search="<%= sp.common_name %>"<%= filter.speciesId === sp.id ? ' selected' : '' %>><%= sp.scientific_name %></option>
          <% }); %>
        </optgroup>
      <% }); %>
    </select>
  </span>
  <span class="gallery-filters__pick">
    <select aria-label="Photos d'un bac" data-picker data-filter="bac">
      <option value="">Tous les bacs</option>
      <% bacs.forEach(function (b) { %>
        <option value="<%= b.id %>" data-pics="<%= bacPics(b) %>"<%= filter.bacId === b.id ? ' selected' : '' %>>Bac <%= fmt.numTag(b.id) %> — <%= b.residents %></option>
      <% }); %>
    </select>
  </span>
</nav>

<% if (top.length) { %>
  <section class="gallery-best">
    <div class="section-title"><h2>Les meilleures</h2><div class="rule"></div><div class="count">4 et 5 étoiles</div></div>
    <div class="photo-strip photo-strip--best" data-photo-group>
      <% top.forEach(function (photo) { %><%- include('_thumb', { photo: photo, withSpecies: true }) %><% }); %>
    </div>
  </section>
<% } else if (total && !filter.byStars) { %>
  <p class="gallery-hint">Ouvre une photo et donne-lui des étoiles : les meilleures s'afficheront ici, et passeront en premier partout.</p>
<% } %>

<% if (!groups.length) { %>
  <div class="gallery-empty">
    <p><%= filter.label ? 'Pas encore de photo ici.' : "Pas encore de photo. Ajoute-en depuis la page d'un bac ou avec le bouton ci-dessus." %></p>
  </div>
<% } %>

<div data-photo-group>
  <% groups.forEach(function (g) { %>
    <section class="gallery-month">
      <div class="section-title"><h2><%= g.label %></h2><div class="rule"></div><div class="count"><%= plural(g.photos.length, 'photo') %></div></div>
      <div class="gallery-grid">
        <% g.photos.forEach(function (photo) { %>
          <%- include('_thumb', { photo: photo, withSpecies: true }) %>
        <% }); %>
      </div>
    </section>
  <% }); %>
</div>

<script>
  (function () {
    // Choosing a species or a bac shows its photos (one filter at a time),
    // keeping the order chosen.
    document.querySelectorAll('[data-filter]').forEach(function (select) {
      select.addEventListener('change', function () {
        var url = new URL(location.href);
        ['bac', 'espece', 'notice'].forEach(function (k) { url.searchParams.delete(k); });
        if (select.value) url.searchParams.set(select.dataset.filter, select.value);
        location.href = url.pathname + url.search;
      });
    });
    // "+ Ajouter des photos" opens the panel above.
    var panel = document.getElementById('ajouter');
    document.querySelector('[data-open-add]').addEventListener('click', function (event) {
      event.preventDefault();
      panel.open = !panel.open;
      if (panel.open) panel.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
    if (location.hash === '#ajouter') panel.open = true;
    <% if (notice) { %>
    document.addEventListener('DOMContentLoaded', function () {
      var toast = document.getElementById('toast');
      toast.textContent = <%- JSON.stringify(notice).replace(/</g, '\\u003c') %>;
      toast.hidden = false;
      setTimeout(function () { toast.hidden = true; }, 2600);
      var url = new URL(location.href);
      url.searchParams.delete('notice');
      history.replaceState(null, '', url.pathname + url.search);
    });
    <% } %>
  })();
</script>

<%- include('../partials/footer') %>
